{
  "name": "explicador",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code plugin that explains software systems with animated, interactive diagrams.",
  "type": "module",
  "workspaces": [
    "server",
    "viewer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e && tsc -p evals",
    "lint": "oxlint",
    "test": "npm test --workspaces --if-present && npm run test:evals",
    "test:evals": "node --test --test-reporter=spec \"evals/test/**/*.test.ts\"",
    "preview": "node server/src/preview.ts",
    "e2e": "playwright test --project chromium --trace off",
    "e2e:all": "playwright test --trace off",
    "eval": "node evals/run.ts",
    "eval:comprension": "node evals/comprehension.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  }
}
